# Provider order controls. These are optional, but useful on Render.
# Valid values: groq, huggingface, ollama, gemini
AI_PROVIDER="groq"
LLM_PROVIDER="groq"
AI_FALLBACK_PROVIDER="huggingface"

# GROQ_API_KEY: Primary hosted provider.
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="llama-3.1-8b-instant"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# HF_TOKEN: Secondary hosted provider through Hugging Face Inference Providers.
# Official OpenAI-compatible router docs:
# https://huggingface.co/docs/inference-providers/tasks/chat-completion
HF_TOKEN="MY_HF_TOKEN"
HF_MODEL="meta-llama/Llama-3.1-8B-Instruct:fastest"
HF_API_URL="https://router.huggingface.co/v1"

# OLLAMA_MODEL: Optional third provider when your deployment can reach an Ollama server.
# On Render, this only works if OLLAMA_BASE_URL points to a remote reachable host.
OLLAMA_MODEL=""
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_AUTOSTART="false"
OLLAMA_PULL_ON_BOOT="false"
OLLAMA_STARTUP_TIMEOUT_MS="120000"
LLM_REQUEST_TIMEOUT_MS="20000"
MAX_INTENT_CHARS="50000"
RESEARCH_TOPIC_COUNT="3"

# GEMINI_API_KEY: Optional legacy fallback if you still want Gemini available.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3-flash-preview"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Production auth. When both are set, the API and websocket surface require a signed operator session.
OPERATOR_PASSCODE="SET_A_LONG_OPERATOR_PASSCODE"
AUTH_SESSION_SECRET="SET_A_LONG_RANDOM_SESSION_SECRET"

# Durable persistence. Recommended for production Render deployments.
DATABASE_URL=""
DATABASE_SSL="false"
